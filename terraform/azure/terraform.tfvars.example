# Copy to terraform.tfvars and fill in real values.

subscription_id     = "your-azure-subscription-id"
sql_admin_password  = "your-sql-admin-password"
azure_region = "southeastasia"
aws_base_url = "https://your-api-id.execute-api.your-region.amazonaws.com"

# must match the aws stack exactly - a token issued by one cloud is
# validated by the other
jwt_secret = "same-64-char-hex-value-as-the-aws-stack"

# shared with the aws stack - guards the /replicate/* endpoints
replication_secret = "your-64-char-hex-secret"

# separate secret for the recovery-reconcile webhook
recovery_secret = "your-64-char-hex-secret"
