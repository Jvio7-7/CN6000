# Copy to terraform.tfvars and replace the placeholders with real values.

subscription_id    = "your-azure-subscription-id"
sql_admin_password = "your-sql-admin-password"
aws_base_url       = "https://your-aws-api-id.execute-api.your-region.amazonaws.com"

# Must be the exact same value as terraform/aws/terraform.tfvars - this is
# what lets a token issued by one cloud validate on the other.
jwt_secret = "your-64-char-hex-secret-same-on-both-clouds"
