# Copy to terraform.tfvars and replace the placeholders with real values.

db_password    = "your-db-password"
azure_base_url = "https://your-azure-function-app.azurewebsites.net/api"

# Must be the exact same value in terraform/azure/terraform.tfvars too.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
jwt_secret = "your-64-char-hex-secret-same-on-both-clouds"
