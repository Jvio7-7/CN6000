# Copy to terraform.tfvars and fill in real values.

db_password    = "your-rds-password"
azure_base_url = "https://your-function-app.azurewebsites.net"
jwt_secret     = "same-64-char-hex-value-as-the-azure-stack"

# shared with the azure stack - guards the /replicate/* endpoints
replication_secret = "your-64-char-hex-secret"
